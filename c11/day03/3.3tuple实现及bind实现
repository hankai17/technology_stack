template<typename ...T>
class mytuple;                                          // 前向声明

template<typename HEAD, typename ...TLIST>              // 递归型(继承)偏特化版本
class mytuple<HEAD, TLIST...> : public mytuple<TLIST...>
{
public:
    mytuple(HEAD head, TLIST... args) :
            mytuple<TLIST...>(args...),
            value(head) {}
    HEAD value;
};

template<>
class mytuple<>                                         // 结束条件特化版本
{
};

