# 颜色定义
declare -A COLORS=(
    [GREEN]='\033[0;32m'
    [BLUE]='\033[0;34m'
    [RED]='\033[0;31m'
    [YELLOW]='\033[1;33m'
    [NC]='\033[0m'
)

log() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    
    case "$level" in
        "INFO")
            echo -e "${COLORS[BLUE]}[*] $message${COLORS[NC]}"
            ;;
        "SUCCESS")
            echo -e "${COLORS[GREEN]}[+] $message${COLORS[NC]}"
            ;;
        "WARNING")
            echo -e "${COLORS[YELLOW]}[!] $message${COLORS[NC]}"
            ;;
        "ERROR")
            echo -e "${COLORS[RED]}[-] $message${COLORS[NC]}"
            ;;
    esac
}

ssh_cmd() {
    local cmd="$1"
    ssh -q -o BatchMode=yes ${CONFIG[SSH_USER]}@${CONFIG[SERVER_IP]} "$cmd"
}

# XDP延迟测试函数
test_xdp_latency() {
    local test_name=$1
    local results_dir="test_results/${test_name}/latency"
    mkdir -p "$results_dir"
    
    echo -e "${COLORS[BLUE]}[*] 开始XDP延迟测试...${COLORS[NC]}"
    
    # 1. 基准延迟测试
    echo -e "${COLORS[BLUE]}[1/4] 测量基准延迟...${COLORS[NC]}"
    measure_baseline_latency "$results_dir"
    
    # 2. XDP加载后延迟测试
    echo -e "${COLORS[BLUE]}[2/4] 测量XDP程序延迟...${COLORS[NC]}"
    measure_xdp_latency "$results_dir"
    
    # 3. 规则匹配延迟测
    echo -e "${COLORS[BLUE]}[3/4] 测量规则匹配延迟...${COLORS[NC]}"
    measure_rule_matching_latency "$results_dir"
    
    # 4. 分析延迟结果
    echo -e "${COLORS[BLUE]}[4/4] 分析延迟数据...${COLORS[NC]}"
    analyze_latency_results "$results_dir"
}

# 测量基准延迟
measure_baseline_latency() {
    local results_dir=$1
    local output_file="${results_dir}/baseline_latency.txt"
    
    echo -e "${COLORS[BLUE]}[*] 卸载XDP程序...${COLORS[NC]}"
    # 确保XDP程序被卸载
    xdp_operations "unload"
    
    # 验证XDP程序已卸载
    if ssh_cmd "${CONFIG[BPFTOOL]} net show dev eth0" | grep -q "xdp"; then
        echo -e "${COLORS[RED]}错误: 无法卸载XDP程序${COLORS[NC]}"
        return 1
    fi
    
    echo -e "${COLORS[GREEN]}✓ XDP程序已卸载${COLORS[NC]}"
    sleep 2  # 等待系统稳定
    
    # 不同包大小进行测试
    for size in ${LATENCY_CONFIG[PACKET_SIZES]}; do
        echo "测试包大小: ${size}字节"
        
        # 预热
        ping -c ${LATENCY_CONFIG[WARMUP_TIME]} -i 0.1 -s $size ${CONFIG[SERVER_IP]} >/dev/null
        
        # 详细延迟测试
        ping -c ${LATENCY_CONFIG[SAMPLES]} -i ${LATENCY_CONFIG[INTERVAL]} -s $size ${CONFIG[SERVER_IP]} | \
            tee -a "$output_file"
    done
}

# 测量XDP程序延迟
measure_xdp_latency() {
    local results_dir=$1
    local output_file="${results_dir}/xdp_latency.txt"
    
    # 加载XDP程序
    xdp_operations "load"
    
    # 验证XDP程序已加载
    ssh ${CONFIG[SSH_USER]}@${CONFIG[SERVER_IP]} "${CONFIG[BPFTOOL]} net show dev eth0" | grep -q "xdp" || {
        echo -e "${COLORS[RED]}错误: XDP程序未正确加载${COLORS[NC]}"
        return 1
    }
    
    # 对不同包大小进行测试
    for size in ${LATENCY_CONFIG[PACKET_SIZES]}; do
        echo "测试包大小: ${size}字节"
        
        # 预热
        ping -c ${LATENCY_CONFIG[WARMUP_TIME]} -i 0.1 -s $size ${CONFIG[SERVER_IP]} >/dev/null
        
        # 详细延迟测试
        ping -c ${LATENCY_CONFIG[SAMPLES]} -i ${LATENCY_CONFIG[INTERVAL]} -s $size ${CONFIG[SERVER_IP]} | \
            tee -a "$output_file"
    done
}

# 测量规则匹配延迟
measure_rule_matching_latency() {
    local results_dir=$1
    local output_file="${results_dir}/rule_matching_latency.txt"
    
    echo -e "${COLORS[BLUE]}[*] 测量规则匹配延迟...${COLORS[NC]}"
    
    # 生成测试规则
    local test_rules=1000
    generate_test_rules "$test_rules"
    
    # 验证规则已加载
    if ! ssh_cmd "${CONFIG[BPFTOOL]} map show" | grep -q "xdp_filter"; then
        echo -e "${COLORS[RED]}错误: 规则加载失败${COLORS[NC]}"
        return 1
    fi
    
    # 对不同包大小进行测试
    for size in ${LATENCY_CONFIG[PACKET_SIZES]}; do
        echo "测试包大小: ${size}字节"
        
        # 预热
        ping -c ${LATENCY_CONFIG[WARMUP_TIME]} -i 0.1 -s $size ${CONFIG[SERVER_IP]} >/dev/null
        
        # 详细延迟测试
        ping -c ${LATENCY_CONFIG[SAMPLES]} -i ${LATENCY_CONFIG[INTERVAL]} -s $size ${CONFIG[SERVER_IP]} | \
            tee -a "$output_file"
    done
    
    # 清理测试规则
    cleanup_test_rules
}

# 分析延迟结果
analyze_latency_results() {
    local results_dir=$1
    echo -e "${COLORS[BLUE]}[*] 分析延迟测试结果...${COLORS[NC]}"
    
    # 分析基准延迟
    local baseline_file="${results_dir}/baseline_latency.txt"
    local xdp_file="${results_dir}/xdp_latency.txt"
    local rule_file="${results_dir}/rule_matching_latency.txt"
    
    # 创建结果摘要文件
    local summary_file="${results_dir}/summary.txt"
    {
        echo "=== XDP延迟测试结果摘要 ==="
        echo "测试时间: $(date)"
        echo ""
        
        echo "1. 基准延迟:"
        awk '/time=/ {sum+=$7; count++} END {printf "  平均延迟: %.2f ms\n", sum/count}' "$baseline_file"
        
        echo "2. XDP程序延迟:"
        awk '/time=/ {sum+=$7; count++} END {printf "  平均延迟: %.2f ms\n", sum/count}' "$xdp_file"
        
        echo "3. 规则匹配延迟:"
        awk '/time=/ {sum+=$7; count++} END {printf "  平均延迟: %.2f ms\n", sum/count}' "$rule_file"
        
    } > "$summary_file"
    
    echo -e "${COLORS[GREEN]}[+] 延迟分析完成，结果保存在 ${summary_file}${COLORS[NC]}"
}

# 在脚本开头添加
trap cleanup SIGINT SIGTERM

cleanup() {
    local error_type=$1
    log "INFO" "开始清理环境..."
    
    # 停止所有监控进程
    pkill -f "sar|mpstat|vmstat" 2>/dev/null || true
    
    # 清理本地进程
    pkill -f "iperf3" 2>/dev/null || true
    
    # 清理服务器端
    ssh_cmd "
        # 停止性能测试进程
        pkill -f 'iperf3|sar|mpstat|vmstat' 2>/dev/null || true
        
        # 卸载XDP程序
        ${CONFIG[BPFTOOL]} net detach xdp dev eth0 2>/dev/null || true
        rm -f /sys/fs/bpf/xdp_filter* 2>/dev/null || true
        
        # 清理临时文件
        rm -rf /tmp/xdp_monitoring 2>/dev/null || true
        rm -rf /tmp/xdp_backup 2>/dev/null || true
    "
    
    # 恢复网络配置
    restore_network_config
    
    if [ "$error_type" = "error" ]; then
        log "ERROR" "测试因错误而终止"
        exit 1
    else
        log "SUCCESS" "清理完成"
    fi
}

