# 获取map ID通过名称
get_map_id() {
    local map_name=$1
    ssh ${CONFIG[SSH_USER]}@${CONFIG[SERVER_IP]} "
        prog_id=\$(${CONFIG[BPFTOOL]} prog show | grep xdp_filter | awk '{print \$1}' | sed 's/://')
        if [ -z \"\$prog_id\" ]; then
            exit 1
        fi
        
        map_ids=\$(${CONFIG[BPFTOOL]} prog show id \$prog_id | grep map_ids | sed 's/.*map_ids //' | tr -d '[]' | tr ',' ' ')
        
        for map_id in \$map_ids; do
            name=\$(${CONFIG[BPFTOOL]} map show id \$map_id | grep name | awk '{print \$3}')
            if [ \"\$name\" = \"$map_name\" ]; then
                echo \$map_id
                exit 0
            fi
        done
        exit 1
    "
}

# 白名单管理函数
manage_whitelist() {
    local action=$1
    local rules_file=$2
    
    echo -e "${COLORS[BLUE]}[*] 白名单操作: $action${COLORS[NC]}"
    
    ssh_cmd "
        # 检查XDP程序
        if ! ${CONFIG[BPFTOOL]} net show dev eth0 | grep -q 'xdp'; then
            echo '误: XDP程序未加载'
            exit 1
        fi
        
        # 获取程序ID
        prog_id=\$(${CONFIG[BPFTOOL]} net show dev eth0 | grep 'prog id' | awk '{print \$NF}')
        if [ -z \"\$prog_id\" ]; then
            echo '错误: 无法获取XDP程序ID'
            exit 1
        fi
        
        # 获取map IDs
        map_info=\$(${CONFIG[BPFTOOL]} prog show id \$prog_id)
        map_ids=\$(echo \"\$map_info\" | grep -oP 'map_ids \K[0-9,]+' | tr -d '[]')
        
        # 查找whitelist map
        for id in \$(echo \$map_ids | tr ',' ' '); do
            map_info=\$(${CONFIG[BPFTOOL]} map show id \$id)
            if echo \"\$map_info\" | grep -q 'name whitelist_v4'; then
                whitelist_map_id=\$id
                break
            fi
        done
        
        if [ -z \"\$whitelist_map_id\" ]; then
            echo '错误: 未找到whitelist map'
            exit 1
        fi
        
        case \"$action\" in
            \"add\")
                # 批量添加白名单规则
                batch_size=1000
                total_ips=10000
                start_count=0
                
                while [ \$start_count -lt \$total_ips ]; do
                    remaining=\$(( total_ips - start_count ))
                    current_batch=\$(( remaining > batch_size ? batch_size : remaining ))
                    
                    # 创建临时批处理文件
                    tmp_file=\$(mktemp)
                    
                    # 生成批处理命令
                    for ((i=0; i<current_batch; i++)); do
                        section=\$(( (start_count + i) / 250 + 1 ))
                        ip=\$(( (start_count + i) % 250 + 1 ))
                        printf 'map update id %d key hex 0a 01 %02x %02x value hex 00 00 00 01\n' \
                            \$whitelist_map_id \$section \$ip >> \$tmp_file
                    done
                    
                    # 执行批处理
                    ${CONFIG[BPFTOOL]} batch file \$tmp_file
                    rm -f \$tmp_file
                    
                    start_count=\$(( start_count + current_batch ))
                    echo \"已添加: \$start_count/\$total_ips\"
                done
                echo '✓ 白名单规则添加完成'
                ;;
                
            \"clear\")
                ${CONFIG[BPFTOOL]} map flush id \$whitelist_map_id
                echo '✓ 白名单已清空'
                ;;
                
            \"update_batch\")
                if [ -n \"$rules_file\" ] && [ -f \"$rules_file\" ]; then
                    while read -r ip; do
                        ${CONFIG[BPFTOOL]} map update id \$whitelist_map_id key hex \
                            \$(printf '%02x' \$(echo \$ip | tr '.' ' ')) \
                            value hex 00 00 00 00
                    done < \"$rules_file\"
                fi
                ;;
        esac
    "
}


