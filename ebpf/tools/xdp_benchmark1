# 分析测试结果
analyze_results() {
    local test_name=$1
    local packet_size=$2
    local results_dir="test_results/${test_name}"
    
    log "INFO" "析测试结果..."
    
    # 汇总吞吐量和PPS
    local total_throughput=0
    local total_pps=0
    
    for log_file in "$results_dir"/thread_*.log; do
        if [ -f "$log_file" ]; then
            # 提取最后一行的吞吐量数据
            local last_line=$(tail -n 1 "$log_file")
            if [[ $last_line =~ ([0-9.]+)\ ([KMG]?)bits/sec ]]; then
                local value=${BASH_REMATCH[1]}
                local unit=${BASH_REMATCH[2]}
                
                # 转换为Mbps
                case "$unit" in
                    "G") value=$(echo "$value * 1000" | bc) ;;
                    "K") value=$(echo "$value / 1000" | bc) ;;
                    "")  value=$(echo "$value / 1000000" | bc) ;;
                esac
                
                total_throughput=$(echo "$total_throughput + $value" | bc)
                
                # 计算PPS
                local pps=$(echo "($value * 1000000) / ($packet_size * 8)" | bc)
                total_pps=$(echo "$total_pps + $pps" | bc)
            fi
        fi
    done
    
    # 保存结果
    {
        echo "测试名称: $test_name"
        echo "包大小: $packet_size bytes"
        echo "总吞吐量: $total_throughput Mbps"
        echo "总PPS: $total_pps pps"
        echo "---"
    } >> "$results_dir/summary.txt"
    
    log "SUCCESS" "结果分析完成"
}

# 动态更新规则函数
update_rules_dynamically() {
    local map_type=$1  # blacklist 或 whitelist
    local start_time=$(date +%s.%N)
    local update_count=0
    local delays=()

    echo -e "${BLUE}[*] 开始动态更新 $map_type 规则...${NC}"

    while [ $update_count -lt $UPDATE_TOTAL_RULES ]; do
        local batch_start=$(date +%s.%N)
        
        # 生成新的规则批次
        local tmp_rules=$(mktemp)
        for ((i=0; i<UPDATE_BATCH_SIZE; i++)); do
            local ip1=$((RANDOM % 254 + 1))
            local ip2=$((RANDOM % 254 + 1))
            echo "10.${ip1}.${ip2}.1" >> "$tmp_rules"
        done

        # 更新规则
        if [ "$map_type" = "blacklist" ]; then
            manage_blacklist "update_batch" "$tmp_rules"
        else
            manage_whitelist "update_batch" "$tmp_rules"
        fi

        # 计算本次更新延迟
        local batch_end=$(date +%s.%N)
        local delay=$(echo "$batch_end - $batch_start" | bc)
        delays+=($delay)

        # 更新计数
        update_count=$((update_count + UPDATE_BATCH_SIZE))
        
        # 等待指定间隔
        sleep $UPDATE_INTERVAL
    done

    # 计算统计信息
    local end_time=$(date +%s.%N)
    local total_time=$(echo "$end_time - $start_time" | bc)
    
    # 计算平均延迟和最大延迟
    local total_delay=0
    local max_delay=0
    for delay in "${delays[@]}"; do
        total_delay=$(echo "$total_delay + $delay" | bc)
        if (( $(echo "$delay > $max_delay" | bc -l) )); then
            max_delay=$delay
        fi
    done
    local avg_delay=$(echo "scale=6; $total_delay / ${#delays[@]}" | bc)

    # 保存统计结果
    echo "$total_time $avg_delay $max_delay" > "test_results/dynamic_update_${map_type}_stats.txt"

    echo -e "${GREEN}[+] 动态更新完成${NC}"
    echo "总耗时: ${total_time}秒"
    echo "平延迟: ${avg_delay}秒"
    echo "最大延迟: ${max_delay}秒"
}

# 混合规则管函数
manage_mixed_rules() {
    local action=$1
    
    echo -e "${BLUE}[*] 混规则操作: $action${NC}"
    
    case "$action" in
        "setup")
            # 清理现有规则
            manage_blacklist "clear"
            manage_whitelist "clear"
            
            # 添加黑名单规则
            echo -e "${BLUE}[*] 配置黑名单规则...${NC}"
            manage_blacklist "add"
            
            # 添加白单规则（使用不同的IP范围）
            echo -e "${BLUE}[*] 配置白名单规则...${NC}"
            ssh ${SSH_USER}@${SERVER_IP} "
                whitelist_map_id=\$(${CONFIG[BPFTOOL]} map show | grep whitelist_v4 | awk '{print \$1}')
                
                # 使用不同的IP范围避免冲突
                for ((i=0; i<$MIXED_RULES_SIZE; i++)); do
                    ip1=\$((i / 254 + 1))
                    ip2=\$((i % 254 + 1))
                    ${CONFIG[BPFTOOL]} map update id \$whitelist_map_id \
                        key hex 0a 02 \$(printf '%02x' \$ip1) \$(printf '%02x' \$ip2) \
                        value hex 00 00 00 01
                done
            "
            ;;
            
        "cleanup")
            # 清理所有规则
            manage_blacklist "clear"
            manage_whitelist "clear"
            ;;
            
        "verify")
            # 验证规则数量
            local black_count=$(ssh ${SSH_USER}@${SERVER_IP} "
                blacklist_map_id=\$(${CONFIG[BPFTOOL]} map show | grep blacklist_v4 | awk '{print \$1}')
                ${CONFIG[BPFTOOL]} map dump id \$blacklist_map_id | wc -l
            ")
            
            local white_count=$(ssh ${SSH_USER}@${SERVER_IP} "
                whitelist_map_id=\$(${CONFIG[BPFTOOL]} map show | grep whitelist_v4 | awk '{print \$1}')
                ${CONFIG[BPFTOOL]} map dump id \$whitelist_map_id | wc -l
            ")
            
            echo "黑名单规则数: $black_count"
            echo "白名单规则数: $white_count"
            
            # 验证规则是否正确加载
            if [ "$black_count" -ne "$MIXED_RULES_SIZE" ] || [ "$white_count" -ne "$MIXED_RULES_SIZE" ]; then
                echo -e "${RED}错误: 规则数量不符合预期${NC}"
                return 1
            fi
            ;;
    esac
}

# 并发更新线程函数
concurrent_update_thread() {
    local thread_id=$1
    local map_type=$2
    local start_ip=$((thread_id * CONCURRENT_UPDATES_PER_THREAD))
    local stats_file="test_results/concurrent_update/thread_${thread_id}_stats.txt"
    local updates_completed=0
    local total_delay=0
    local max_delay=0
    
    echo "线程 $thread_id 开始更新规则..."
    
    while [ $updates_completed -lt $CONCURRENT_UPDATES_PER_THREAD ]; do
        local batch_start=$(date +%s.%N)
        
        # 生成批量规则
        local tmp_rules=$(mktemp)
        for ((i=0; i<CONCURRENT_BATCH_SIZE; i++)); do
            local ip_num=$((start_ip + updates_completed + i))
            local ip1=$((ip_num / 254 + 1))
            local ip2=$((ip_num % 254 + 1))
            echo "10.${ip1}.${ip2}.1" >> "$tmp_rules"
        done
        
        # 更新规
        if [ "$map_type" = "blacklist" ]; then
            manage_blacklist "update_batch" "$tmp_rules" >/dev/null 2>&1
        else
            manage_whitelist "update_batch" "$tmp_rules" >/dev/null 2>&1
        fi
        
        # 清理临时文件
        rm -f "$tmp_rules"
        
        # 计算延迟
        local batch_end=$(date +%s.%N)
        local delay=$(echo "$batch_end - $batch_start" | bc)
        total_delay=$(echo "$total_delay + $delay" | bc)
        
        # 更新最大延迟
        if (( $(echo "$delay > $max_delay" | bc -l) )); then
            max_delay=$delay
        fi
        
        updates_completed=$((updates_completed + CONCURRENT_BATCH_SIZE))
        sleep $CONCURRENT_UPDATE_INTERVAL
    done
    
    # 保存统计信息
    echo "$updates_completed $total_delay $max_delay" > "$stats_file"
}

# 验证规则一致性
verify_rule_consistency() {
    local map_type=$1
    local expected_total=$((CONCURRENT_THREADS * CONCURRENT_UPDATES_PER_THREAD))
    
