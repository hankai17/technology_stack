# 测试结果验证函数
validate_results() {
    local test_name=$1
    local results_dir="test_results/${test_name}"
    local valid=true
    
    log "INFO" "验证测试结果: $test_name"
    
    # 检查结果文件是否存在
    if [ ! -d "$results_dir" ]; then
        log "ERROR" "结果目录不存在: $results_dir"
        return 1
    fi
    
    # 检性能数据
    for log_file in "$results_dir"/thread_*.log; do
        if [ ! -f "$log_file" ] || [ ! -s "$log_file" ]; then
            log "ERROR" "性能数据文件无效: $log_file"
            valid=false
            continue
        fi
        
        # 检查是否包含有效的性能数据
        if ! grep -q "sender" "$log_file"; then
            log "WARNING" "性能数据文件可能不完整: $log_file"
            valid=false
        fi
    done
    
    # 检查监控数据
    if [ ! -f "$results_dir/monitoring/cpu.log" ] || \
       [ ! -f "$results_dir/monitoring/memory.log" ] || \
       [ ! -f "$results_dir/monitoring/network.log" ]; then
        log "WARNING" "监控数据文件不完整"
        valid=false
    fi
    
    if [ "$valid" = true ]; then
        log "SUCCESS" "测试结果验证通过"
        return 0
    else
        log "ERROR" "测试结果验失败"
        return 1
    fi
}

# 主函数
main() {
    # 解析命令行参数
    parse_arguments "$@"
    
