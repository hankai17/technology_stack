# SSH命令执行函数


# 启动性能监控
start_monitoring() {
    local test_name=$1
    local monitor_dir="test_results/${test_name}/monitoring"
    mkdir -p "$monitor_dir"
    
    echo -e "${COLORS[BLUE]}[*] 启动性能监控...${COLORS[NC]}"
    
    # 在服务器端启动监控
    ssh_cmd "
        mkdir -p /tmp/xdp_monitoring
        
        # CPU使用率监控
        mpstat ${MONITOR_CONFIG[INTERVAL]} > /tmp/xdp_monitoring/cpu.log &
        
        # 内存使用率监控
        vmstat ${MONITOR_CONFIG[INTERVAL]} > /tmp/xdp_monitoring/memory.log &
        
        # 网络统计监控
        sar -n DEV ${MONITOR_CONFIG[INTERVAL]} > /tmp/xdp_monitoring/network.log &
    "
}

# 停止性能监控
stop_monitoring() {
    local test_name=$1
    local monitor_dir="test_results/${test_name}/monitoring"
    
    echo -e "${COLORS[BLUE]}[*] 停止性能监控...${COLORS[NC]}"
    
    # 停止服务器端监控进程
    ssh_cmd "
        pkill -9 mpstat 2>/dev/null || true
        pkill -9 vmstat 2>/dev/null || true
        pkill -9 sar 2>/dev/null || true
        
        # 收集监控数据
        if [ -d /tmp/xdp_monitoring ]; then
            tar czf /tmp/monitoring_data.tar.gz -C /tmp xdp_monitoring/
            rm -rf /tmp/xdp_monitoring
        fi
    "
    
    # 获取监控数据
    scp ${CONFIG[SSH_USER]}@${CONFIG[SERVER_IP]}:/tmp/monitoring_data.tar.gz "$monitor_dir/" &>/dev/null
    ssh_cmd "rm -f /tmp/monitoring_data.tar.gz"
    
    # 解压监控数据
    if [ -f "$monitor_dir/monitoring_data.tar.gz" ]; then
        tar xzf "$monitor_dir/monitoring_data.tar.gz" -C "$monitor_dir"
        rm -f "$monitor_dir/monitoring_data.tar.gz"
    fi
}

# 运行性能测试
run_performance_test() {
    local test_name=$1
    local packet_size=$2
    local description=$3
    local results_dir="test_results/${test_name}"
    
    mkdir -p "$results_dir"
    log "INFO" "执行性能测试: $description"
    
    # 启动监控
    local monitor_pids=$(start_monitoring "$test_name")
    
    # 在服务器端启动iperf3服务器
    ssh_cmd "
        for port in \$(seq ${TEST_PARAMS[START_PORT]} \$((${TEST_PARAMS[START_PORT]}+${TEST_PARAMS[THREADS]}-1))); do
            iperf3 -s -p \$port -D
        done
    "
    
    # 本地启动iperf3客户端
    local client_pids=()
    for ((i=0; i<${TEST_PARAMS[THREADS]}; i++)); do
        port=$((${TEST_PARAMS[START_PORT]}+i))
        iperf3 -c ${CONFIG[SERVER_IP]} -p $port \
            -t ${TEST_PARAMS[TEST_DURATION]} \
            -l $packet_size -b 0 -i 1 \
            --logfile "$results_dir/thread_${i}.log" &
        client_pids+=($!)
    done
    
    # 等待所有客户端完成
    for pid in "\${client_pids[@]}"; do
        wait $pid
    done
    
    # 停止监控和清理
    stop_monitoring "$monitor_pids"
    ssh_cmd "pkill -9 iperf3 2>/dev/null || true"
    
    # 分析结果
    analyze_results "$test_name" "$packet_size"
}

