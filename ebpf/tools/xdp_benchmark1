    ssh_cmd "
        # 清空map
        ${CONFIG[BPFTOOL]} map flush pinned /sys/fs/bpf/xdp_filter_blacklist 2>/dev/null || true
        # 删除规则文件
        rm -f '${CONFIG[XDP_PATH]}/rules/test_rules.txt' 2>/dev/null || true
    "
    
