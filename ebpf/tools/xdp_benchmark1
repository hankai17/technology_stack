    local test_dir="test_results_${timestamp}"
    mkdir -p "$test_dir"
    cd "$test_dir"
    
    # 根据测试模式执行不同的测试
    case "$TEST_MODE" in
        "all")
            log "INFO" "执行所有测试..."
            IFS=',' read -ra STAGES <<< "$selected_stages"
            for stage in "${STAGES[@]}"; do
                run_test_stage "$stage"
            done
            ;;
            
        "baseline")
            log "INFO" "执行基准测试..."
            xdp_operations "unload"
            run_performance_test "baseline" "${TEST_PARAMS[PPS_PACKET]}" "基准测试 - PPS"
            run_performance_test "baseline" "${TEST_PARAMS[SMALL_PACKET]}" "基准测试 - 小包"
