    ")
    
    echo "预期规则数: $expected_total"
    echo "实际规则: $actual_count"
    
    if [ "$actual_count" -ne "$expected_total" ]; then
        echo -e "${RED}错误: 规则数量不一致${NC}"
        return 1
    fi
    
    return 0
}

