            run_performance_test "xdp_rules" "${TEST_PARAMS[PPS_PACKET]}" "XDP规则测试"
            
            # 清理规则
            manage_blacklist "clear"
            ;;
            
        *)
            handle_error "无效的测试阶段: $stage"
            ;;
    esac
}

