# 系优化函数
optimize_system_settings() {
    echo -e "${COLORS[BLUE]}[*] 优化系统设置...${COLORS[NC]}"
    
    echo "优化本地系统..."
    for param in "${TUNING_PARAMS[@]}"; do
        sudo sysctl -w "$param" >/dev/null 2>&1 || true
    done
    
    echo "优化服务器系统..."
    ssh_cmd "
        # 系统参数优化
        $(printf "sysctl -w %s >/dev/null 2>&1 || true\n" "${TUNING_PARAMS[@]}")
        
        # 网卡优化
        echo '优化网卡 eth0 设置...'
        ethtool -G eth0 rx 4096 tx 4096 2>/dev/null || true
        ethtool -K eth0 gro off gso off tso off 2>/dev/null || true
        ethtool -C eth0 adaptive-rx off adaptive-tx off rx-usecs 0 tx-usecs 0 2>/dev/null || true
        
        # 中断亲和性优化
        if [ -d /proc/irq ]; then
            for irq in \$(grep eth0 /proc/interrupts | awk '{print \$1}' | tr -d ':'); do
                echo 1 > /proc/irq/\$irq/smp_affinity_list 2>/dev/null || true
            done
        fi
    "
    
    echo -e "${COLORS[GREEN]}[+] 系统优化完成${COLORS[NC]}"
}

# 网络配置备份函数
backup_network_config() {
    echo -e "${COLORS[BLUE]}[*] 备份络配置...${COLORS[NC]}"
    
    echo "备份本地网络配置..."
    mkdir -p "backup"
    ip link show > "backup/local_link_config.txt"
    ip addr show > "backup/local_addr_config.txt"
    sysctl -a | grep net > "backup/local_sysctl_config.txt"
    
    echo "备份服务器网络配置..."
    ssh_cmd "
        mkdir -p /tmp/xdp_backup
        ip link show > /tmp/xdp_backup/link_config.txt
        ip addr show > /tmp/xdp_backup/addr_config.txt
        sysctl -a | grep net > /tmp/xdp_backup/sysctl_config.txt
        ethtool -k eth0 > /tmp/xdp_backup/ethtool_config.txt
    "
    
    echo -e "${COLORS[GREEN]}[+] 网络配置备份完成${COLORS[NC]}"
}

# 网络配置恢复函数
restore_network_config() {
    echo -e "${COLORS[BLUE]}[*] 恢复网络配置...${COLORS[NC]}"
    
    ssh_cmd "
        if [ -d /tmp/xdp_backup ]; then
            # 恢复网卡配置
            ethtool -K eth0 \$(grep -v '^Features' /tmp/xdp_backup/ethtool_config.txt)
            
            # 清理备份
            rm -rf /tmp/xdp_backup
        fi
    "
    
    echo -e "${COLORS[GREEN]}[+] 网络配置恢复完成${COLORS[NC]}"
}

# 日志记录函数
log() {
    local level=$1
    local message=$2
    local timestamp=$(date '+%Y-%m-%d %H:%M:%S')
    local log_file="test_results/benchmark.log"
    
    # 确保日志目录存在
    mkdir -p "$(dirname "$log_file")"
    
    case "$level" in
        "INFO")
            echo -e "${COLORS[BLUE]}[*] $message${COLORS[NC]}"
            ;;
        "SUCCESS")
            echo -e "${COLORS[GREEN]}[+] $message${COLORS[NC]}"
            ;;
        "WARNING")
            echo -e "${COLORS[YELLOW]}[!] $message${COLORS[NC]}"
            ;;
        "ERROR")
            echo -e "${COLORS[RED]}[-] $message${COLORS[NC]}"
            ;;
    esac
    
    # 写入日志文件
    echo "[$timestamp] [$level] $message" >> "$log_file"
}

