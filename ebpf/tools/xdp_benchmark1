# XDP操作函数
xdp_operations() {
    local action=$1
    local interface="eth0"  # 添加口变量便于配置
    
    case "$action" in
        "load")
            log "INFO" "加载XDP程序..."
            ssh_cmd "
                # 确保目录存在
                mkdir -p /sys/fs/bpf
                
                # 完全清理旧的XDP程序
                ${CONFIG[BPFTOOL]} net detach xdp dev $interface 2>/dev/null || true
                rm -f /sys/fs/bpf/xdp_filter* 2>/dev/null || true
                sleep 1
                
                cd ${CONFIG[XDP_PATH]}
                if [ ! -f xdp_filter.o ]; then
                    echo '错误: XDP程序文件不存在'
                    exit 1
                fi
                
                # 加载程序并获取 prog_id
                ${CONFIG[BPFTOOL]} prog load xdp_filter.o /sys/fs/bpf/xdp_filter type xdp && \
                ${CONFIG[BPFTOOL]} net attach xdp pinned /sys/fs/bpf/xdp_filter dev $interface
                
                # 验证加载状态
                if ${CONFIG[BPFTOOL]} net show dev $interface | grep -q 'xdp'; then
                    echo '✓ XDP程序加载成功'
                else
                    echo '错误: XDP程序未成功加载'
                    exit 1
                fi
            "
            ;;
            
        "unload")
            log "INFO" "卸载XDP程序..."
            ssh_cmd "
                ${CONFIG[BPFTOOL]} net detach xdp dev $interface 2>/dev/null || true
                rm -f /sys/fs/bpf/xdp_filter* 2>/dev/null || true
                
                # 验证卸载状态
                if ! ${CONFIG[BPFTOOL]} net show dev $interface | grep -q 'xdp'; then
                    echo '✓ XDP程序卸载成功'
                else
                    echo '× XDP程序卸载失败'
                    exit 1
                fi
            "
            ;;
    esac
}

# 生成测试规则
generate_test_rules() {
    local count=$1
    echo -e "${COLORS[BLUE]}[*] 生成${count}条测试规则...${COLORS[NC]}"
    
    # 在服务器端生成规则
    ssh_cmd "
        # 创建规则目录
        mkdir -p '${CONFIG[XDP_PATH]}/rules'
        rules_file='${CONFIG[XDP_PATH]}/rules/test_rules.txt'
        > \$rules_file  # 清空文件
        
        # 生成随机IP规则
        for ((i=1; i<=$count; i++)); do
            echo \"10.\$((RANDOM % 255)).\$((RANDOM % 255)).\$((RANDOM % 255))\" >> \$rules_file
        done
        
        # 使用bpftool更新map
        while read -r ip; do
            ${CONFIG[BPFTOOL]} map update pinned /sys/fs/bpf/xdp_filter_blacklist key hex 0a \
                \$(printf '%02x' \$(echo \$ip | cut -d. -f2-4 | tr '.' ' ')) value hex 00 00 00 00
        done < \$rules_file
    " || {
        echo -e "${COLORS[RED]}错误: 规则生成或加载失败${COLORS[NC]}"
        return 1
    }
    
    echo -e "${COLORS[GREEN]}[+] 规则生成并加载完成${COLORS[NC]}"
    return 0
}

# 清理测试规则
cleanup_test_rules() {
