            ;;
            
        "latency")
            log "INFO" "执行延迟测试..."
            test_xdp_latency "latency"
            ;;
            
        "throughput")
            log "INFO" "执行吞吐量测试..."
            xdp_operations "load"
            run_performance_test "throughput" "${TEST_PARAMS[PPS_PACKET]}" "吞吐量测试 - PPS"
            run_performance_test "throughput" "${TEST_PARAMS[SMALL_PACKET]}" "吞吐量测试 - 小包"
            run_performance_test "throughput" "${TEST_PARAMS[LARGE_PACKET]}" "吞吐量测试 - 大包"
            ;;
            
        "rules")
            log "INFO" "执行规则测试..."
            xdp_operations "load"
            test_xdp_rules "rules"
            ;;
    esac
    
    # 生成测试报告
    if [ "$GENERATE_REPORT" = true ]; then
        generate_report
    fi
    
    # 汇总结果
    summarize_results
    
    # 收集诊断信息
    collect_diagnostics
    
    # 清理环境
    cleanup
    
    # 显示结果位置
    log "SUCCESS" "测试完成!"
    log "INFO" "测试结果保存在: $(pwd)"
    
    # 如果是详细模式，显示更多信息
    if [ "$VERBOSE" = true ]; then
        log "INFO" "可以查看以下文件了解详细结果："
        log "INFO" "- 测试报告：report.html"
        log "INFO" "- 结果汇总：final_summary.txt"
        log "INFO" "- 诊断信息：diagnostics/"
        log "INFO" "- 详细日志：benchmark.log"
    fi
    
    # 返回到原始目录
    cd - >/dev/null
}

