# 解析命令行参数（移到main函数之前）
parse_arguments() {
    local OPTIND opt
    
    # 默认值
    TEST_MODE="all"
    VERBOSE=false
    selected_stages="1,2,3,4"  # 默认执行所有测试阶段
    
    # 解析参数
    while getopts ":m:s:vh" opt; do
        case $opt in
            m)
                case "${OPTARG}" in
                    all|baseline|latency|throughput|rules)
                        TEST_MODE="${OPTARG}"
                        ;;
                    *)
                        echo -e "${COLORS[RED]}错误: 无效的测试模式 ${OPTARG}${COLORS[NC]}"
                        show_usage
                        exit 1
                        ;;
                esac
                ;;
            s)
                selected_stages="${OPTARG}"
                ;;
            v)
                VERBOSE=true
                ;;
            h)
                show_usage
                exit 0
                ;;
            \?)
                echo -e "${COLORS[RED]}错误: 无效的选项 -$OPTARG${COLORS[NC]}"
                show_usage
                exit 1
                ;;
        esac
    done
}

# 显示使用帮助（也要移到main函数之前）
show_usage() {
    cat << EOF
使用方法: $(basename "$0") [-m mode] [-s stages] [-v] [-h]

选项:
    -m mode    测试模式 (all|baseline|latency|throughput|rules)
    -s stages  要执行的测试阶段，用逗号分隔 (1,2,3,4)
    -v         显示详细输出
    -h         显示此帮助信息

测试阶段:
    1. 基准测试
    2. XDP基本测试
    3. XDP延迟测试
    4. XDP规则试
EOF
}

# 验证号的函数
validate_stages() {
    local stages=$1
    local valid=true
    
    # 查式
    if ! echo "$stages" | grep -qE '^[0-9]+(,[0-9]+)*$'; then
        echo -e "${RED}错: 无效的阶段格式。请使用逗号分隔的数字。${NC}"
        return 1
    fi  # 这里缺少了一个 fi
    
    # 检查每个阶段号是否有效
    for stage in $(echo "$stages" | tr ',' ' '); do
        if [ "$stage" -lt 1 ] || [ "$stage" -gt "${#STAGES[@]}" ]; then
            echo -e "${RED}错误: 无效的阶段号 $stage。有效范围: 1-${#STAGES[@]}${NC}"
            valid=false
        fi
    done
    
    [ "$valid" = true ]
}


