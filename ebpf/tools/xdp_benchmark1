# 数解析函数
parse_arguments() {
    local OPTIND opt
    
    # 默认值
    TEST_MODE="all"
    VERBOSE=false
    selected_stages="1,2,3,4"
    
    while getopts ":m:s:vh" opt; do
        case $opt in
            m)
                case "${OPTARG}" in
                    all|baseline|latency|throughput|rules)
                        TEST_MODE="${OPTARG}"
                        ;;
                    *)
                        log "ERROR" "无效的测试模式: ${OPTARG}"
                        show_help
                        exit 1
                        ;;
                esac
                ;;
            s)
                if [[ "${OPTARG}" =~ ^[1-4](,[1-4])*$ ]]; then
                    selected_stages="${OPTARG}"
                else
                    log "ERROR" "无效的测试阶: ${OPTARG}"
                    show_help
                    exit 1
                fi
                ;;
            v)
                VERBOSE=true
                ;;
            h)
                show_help
                exit 0
                ;;
            \?)
                log "ERROR" "无效的选项: -$OPTARG"
                show_help
                exit 1
                ;;
        esac
    done
}

# 系统检查函数
check_system_requirements() {
    log "INFO" "检查系统要求..."
    
    # 检查系统类型
    if [ ! -f /etc/redhat-release ] && [ ! -f /etc/debian_version ]; then
        handle_error "不支持的操作系统"
    fi
    
    # 检查内核版本
    local kernel_version=$(uname -r)
    if ! [[ "$kernel_version" =~ ^[4-9]\. ]] && ! [[ "$kernel_version" =~ ^[1-9][0-9]\. ]]; then
        handle_error "内核版本过低，需要4.x或更高版本"
    fi
    
    # 检查必要工具
    local required_tools=("ssh" "iperf3" "ethtool" "bc" "awk" "grep")
    for tool in "${required_tools[@]}"; do
        if ! command -v "$tool" >/dev/null 2>&1; then
            handle_error "缺少必要工具: $tool"
        fi
    done
    
    # 检查bpftool
    ssh_cmd "
        if [ ! -x '${CONFIG[BPFTOOL]}' ]; then
            echo '错误: bpftool不存在或无执行权限'
            exit 1
        fi
    "
    
    log "SUCCESS" "系统要求检查通过"
}

# 网络检查函数
check_network_connectivity() {
    log "INFO" "检查网络连接..."
    
    # 检查基本连通性
    if ! ping -c 1 -W 2 "${CONFIG[SERVER_IP]}" >/dev/null 2>&1; then
        handle_error "无法连接到服务器 ${CONFIG[SERVER_IP]}"
    fi
    
    # 检查SSH连接
    if ! ssh -q -o BatchMode=yes -o ConnectTimeout=5 \
        "${CONFIG[SSH_USER]}@${CONFIG[SERVER_IP]}" "echo OK" >/dev/null 2>&1; then
        handle_error "SSH连接失败，请确保已配置SSH免密登录"
    fi
    
    # 检查网卡状态
    ssh_cmd "
        if ! ip link show eth0 | grep -q 'UP'; then
            echo '错误: 网卡eth0未启用'
            exit 1
        fi
        
        # 检查网卡驱动是否支持XDP
        if ! ethtool -i eth0 | grep -q 'supports-xdp: yes'; then
            echo '警告: 网卡可能不支持XDP'
        fi
    "
    
    log "SUCCESS" "网络连接检查通过"
}
