                analyze_results "with_xdp_blacklist" $PPS_PACKET

                echo -e "${BLUE}[4/5] 执行小包测试...${NC}"
                run_test "with_xdp_blacklist" $SMALL_PACKET "启用XDP并添加黑名单 - 小包测试"
                analyze_results "with_xdp_blacklist" $SMALL_PACKET

